# =============================================================
# Kittygram — https://artemii-kittygram.ddns.net
# =============================================================
server {
    listen 443 ssl;
    server_name artemii-kittygram.ddns.net;
    ssl_certificate /etc/letsencrypt/live/artemii-kittygram.ddns.net/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/artemii-kittygram.ddns.net/privkey.pem;

    location / {
        root /var/www/kittygram;
        index index.html;
        try_files $uri $uri/ /index.html;
    }

    location /api/ {
        proxy_pass http://127.0.0.1:8080;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        client_max_body_size 20M;
    }

    location /admin/ {
        proxy_pass http://127.0.0.1:8080;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        client_max_body_size 20M;
    }

    location /static/ {
    alias /var/www/kittygram/static/;
    }

    location /media/ {
        alias /var/www/kittygram/media/;
    }
}

server {
    listen 80;
    server_name artemii-kittygram.ddns.net;
    return 301 https://$host$request_uri;
}

