# Блок конфигурации для проекта Kittygram
server {
    listen 80;
    server_name kittygram.artemii-project.ddns.net;

    # Максимальный размер загружаемых фоток котиков по ТЗ
    client_max_body_size 20M;

    # Раздача фронтенда Kittygram
    location / {
        root /var/www/kittygram;
        index index.html index.htm;
        try_files $uri /index.html;
    }

    # Перенаправление запросов к API бэкенда Kittygram (порт 8080)
    location /api/ {
        proxy_set_header Host $http_host;
        proxy_pass http://127.0.0.1:8080;
    }

    # Перенаправление запросов к админке бэкенда Kittygram (порт 8080)
    location /admin/ {
        proxy_set_header Host $http_host;
        proxy_pass http://127.0.0.1:8080;
    }

    # Раздача картинок котиков через директиву alias по ТЗ
    location /media/ {
        alias /var/www/kittygram/media/;
    }
}

